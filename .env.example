# TDV2-1138 reproduction — reporting target. Copy to .env and fill in tokens.
TEST_ENV=stg

# --- Staging (lab.testdino.com UI, stg-reporter ingestion) -------------------
STG_TESTDINO_TOKEN=td_api_xxx
STG_SERVER_URL=https://stg-reporter.testdino.com
